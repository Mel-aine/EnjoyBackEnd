<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>
      Manager Report
    </title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        margin: 0;
        padding: 5px 20px 20px 20px;
        color: #333;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }


      .horizontal-line {
        border-top: 1px solid #333;
        margin: 10px 0;
      }

      .report-info {
        margin-bottom: 20px;
        font-size: 11px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        table-layout: fixed;
      }

      th,
      td {
        text-align: left;
        padding: 4px 0px;
        font-size: 10px;
      }


      .section-title {
        font-weight: bold;
        margin: 0px 0 5px 0;
        font-size: 12px;
      }

      .section-total {
        font-weight: bold;
        border-top: 1px dotted #333;
        border-bottom: 1px dotted #333;
      }

      .section-total-top {
        font-weight: bold;
        border-top: 1px dotted #333;
      }

      .section-total-bottom {
        font-weight: bold;
        border-bottom: 1px dotted #333;
      }

      .section-subtotal {
        font-weight: bold;
        border-top: 1px solid #ddd;
      }

      .bold-section {
        font-weight: bold;
      }

      .currency {
        text-align: right;
      }

      .n1-col {
        text-align: right;
        color: #666;
      }

      .footer-line {
        border-top: 1px solid #333;
        margin-bottom: 5px;
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }


      .font-bold{
        font-weight: 900;
      }
      @media print {
        .page-break {
          padding-top:20px
          page-break-before: always;
        }
      }
    </style>
  </head>
  <body>
    <!-- Header -->

    <div class="main">


      <!-- Section 1: Room Charges -->
      <div class="section-title">
