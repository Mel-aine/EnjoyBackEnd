            </tr>
          @endeach
          <tr class="section-total">
            <td style="width: 32%;"><strong>Total Adjustments</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.adjustments.totals?.today || content.adjustments.today) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.adjustments.totals?.ptd || content.adjustments.ptd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.adjustments.totals?.ytd || content.adjustments.ytd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.adjustments?.totals?.today || content.n1?.adjustments?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>
      @endif

      <!-- Section 5: Tax -->
      <div class="section-title">
        Tax
      </div>
      <table>
        <tbody>
          @each(taxRate in ( content.tax.taxes || []))
            <tr>
              <td style="width: 32%;">{{ taxRate.name }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(taxRate.today) }}</td>
