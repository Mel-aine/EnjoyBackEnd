            <td class="currency"></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 9: Guest Ledger (pas de N-1 : pas de colonne PTD dans la source) -->
      <div class="section-title">
        Guest Ledger
      </div>
      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
          <tr>
            <td>
              Opening Balance
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.openingBalance?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr>
            <td>
              Carry Forwarded Advance Deposit
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.carryForwardedAdvanceDeposit?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr>
            <td>
              Charge Posted to Guest Ledger
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.chargePostedToGuestLedger?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr>
            <td>
              Settlement by Guest
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.settlementByGuest?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr>
            <td>
              Outstanding Payment on Charges
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.outstandingPaymentOnCharges?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr>
            <td>
              Transfer from Advance Deposit
            </td>
            <td class="currency">
              {{ formatCurrency(content.guestLedger?.transferFromAdvanceDeposit?.today) }}
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
          <tr class="section-total">
            <td>
              <strong>Closing Balance</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.guestLedger?.closingBalance?.today) }}</strong>
            </td>
            <td class="currency"></td>
            <td class="n1-col"></td>
            <td class="currency"></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 10: Room Summary -->
      <div class="section-title">
        Room Summary
      </div>
      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
          <tr>
            <td>
              Total Rooms
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.totalRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Blocked Rooms
            </td>
            <td class="currency">
              {{ content.roomSummary?.blockRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.blockRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.blockRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.blockRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No of Guest (Adult/Child)
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfGuestAdult?.today || 0 }}/{{ content.roomSummary?.noOfGuestChild?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfGuestAdult?.ptd || 0 }}/{{ content.roomSummary?.noOfGuestChild?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.noOfGuestAdult?.ytd || 0 }}/{{ contentN1?.roomSummary?.noOfGuestChild?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfGuestAdult?.ytd || 0 }}/{{ content.roomSummary?.noOfGuestChild?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Total Available Room nights
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalAvailableRoomNights?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalAvailableRoomNights?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.totalAvailableRoomNights?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.totalAvailableRoomNights?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Sold Room
            </td>
            <td class="currency">
              {{ content.roomSummary?.soldRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.soldRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.soldRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.soldRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Day Use Room
            </td>
            <td class="currency">
              {{ content.roomSummary?.dayUseRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.dayUseRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.dayUseRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.dayUseRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Complimentary Room
            </td>
            <td class="currency">
              {{ content.roomSummary?.complimentaryRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.complimentaryRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.complimentaryRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.complimentaryRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No Show Rooms
            </td>
            <td class="currency">
              {{ content.roomSummary?.noShows?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noShows?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.noShows?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noShows?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              Average Guest Per Room
            </td>
            <td class="currency">
              {{ content.roomSummary?.averageGuestPerRoom?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.averageGuestPerRoom?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.averageGuestPerRoom?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.averageGuestPerRoom?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No of Reservations (Confirm)
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsConfirm?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsConfirm?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.noOfReservationsConfirm?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsConfirm?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No of Reservations (Unconfirm)
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsUnconfirm?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsUnconfirm?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.noOfReservationsUnconfirm?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfReservationsUnconfirm?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No of Walkins
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfWalkins?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfWalkins?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.noOfWalkins?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.noOfWalkins?.ytd || 0 }}
            </td>
          </tr>
          <tr>
            <td>
              No of Reservation (cancellations)
            </td>
            <td class="currency">
              {{ content.roomSummary?.cancellations?.today || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.cancellations?.ptd || 0 }}
            </td>
            <td class="n1-col">
              {{ contentN1?.roomSummary?.cancellations?.ytd || 0 }}
            </td>
            <td class="currency">
              {{ content.roomSummary?.cancellations?.ytd || 0 }}
            </td>
          </tr>
        </tbody>
      </table>

      <!-- Section 11: Statistics -->
      <div class="section-title">
        Statistics
      </div>
      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
          <tr>
            <td>
              Occupancy Rate (%)
            </td>
            <td class="currency">
              {{ (content.statistics?.occupancyRate?.today || 0).toFixed(0) }}%
            </td>
            <td class="currency">
              {{ (content.statistics?.occupancyRate?.ptd || 0).toFixed(0) }}%
            </td>
            <td class="n1-col">
              {{ (contentN1?.statistics?.occupancyRate?.ytd || 0).toFixed(0) }}%
            </td>
            <td class="currency">
              {{ (content.statistics?.occupancyRate?.ytd || 0).toFixed(0) }}%
            </td>
          </tr>
          <tr>
            <td>
              Average Daily Rate (ADR)
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.averageDailyRate?.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.averageDailyRate?.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(contentN1?.statistics?.averageDailyRate?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.averageDailyRate?.ytd) }}
            </td>
          </tr>
          <tr>
            <td>
              Revenue Per Available Room (RevPAR)
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(contentN1?.statistics?.revenuePerAvailableRoom?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.ytd) }}
            </td>
          </tr>
        </tbody>
      </table>
      <!-- Section 12: POS Summary -->
      <div class="horizontal-line">
      </div>
      <div class="section-title">
        POS Summary
      </div>
      <div class="horizontal-line">
      </div>

      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
        @each(outlet in content.posSummary?.outlets)
          <tr>
            <td class="section-title">
              {{ outlet.outlet }}
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          </tr>
          @each(category in outlet.categories)
            <tr>
              <td>
                {{ category.name }}
              </td>
              <td class="currency">
                {{ formatCurrency(category?.today) }}
              </td>
              <td class="currency">
                {{ formatCurrency(category?.ptd) }}
              </td>
              <td class="n1-col">
                {{ formatCurrency((((contentN1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet))?.categories || []).find((c) => c.name === category.name)?.ytd) }}
              </td>
              <td class="currency">
                {{ formatCurrency(category?.ytd) }}
              </td>
            </tr>
          @endeach
          <tr class="section-total-top">
            <td class="section-title" style="width: 28%;">
              Total Revenue without Tax
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithoutTax.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithoutTax.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(((contentN1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet))?.totalWithoutTax?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithoutTax.ytd) }}
            </td>
          </tr>
          <tr class="section-total-bottom">
            <td class="section-title" style="width: 28%;">
              Total Revenue with Tax
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithTax.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithTax.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(((contentN1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet))?.totalWithTax?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(outlet.totalWithTax.ytd) }}
            </td>
          </tr>
        @endeach
        <tr class="">
          <td>
            <strong>All Outlet's Total Revenue without Tax</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.today) }}</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ptd) }}</strong>
          </td>
          <td class="n1-col">
            <strong>{{ formatCurrency(contentN1?.posSummary?.totalWithoutTax?.ytd) }}</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ytd) }}</strong>
          </td>
        </tr>
        <tr class="section-total-bottom">
          <td>
            <strong>All Outlet's Total Revenue with Tax</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithTax.today) }}</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithTax.ptd) }}</strong>
          </td>
          <td class="n1-col">
            <strong>{{ formatCurrency(contentN1?.posSummary?.totalWithTax?.ytd) }}</strong>
          </td>
          <td class="currency">
            <strong>{{ formatCurrency(content.posSummary?.totalWithTax.ytd) }}</strong>
          </td>
        </tr>
        </tbody>
      </table>

      <!-- Section 13: POS Payment Summary -->
      <div class="horizontal-line">
      </div>
      <div class="section-title">
        POS Payment Summary
      </div>
      <div class="horizontal-line">
      </div>

      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
          @each(outlet in content.posPayment?.outlets)
            <tr>
              <td class="section-title">
                {{ outlet.outlet }}
              </td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
            @each(payment in outlet.payments)
              <tr>
                <td>
                  {{ payment.name }}
                </td>
                <td class="currency">
                  {{ formatCurrency(payment?.today) }}
                </td>
                <td class="currency">
                  {{ formatCurrency(payment?.ptd) }}
                </td>
                <td class="n1-col">
                  {{ formatCurrency((((contentN1?.posPayment?.outlets || []).find((o) => o.outlet === outlet.outlet))?.payments || []).find((p) => p.name === payment.name)?.ytd) }}
                </td>
                <td class="currency">
                  {{ formatCurrency(payment?.ytd) }}
                </td>
              </tr>
            @endeach
            <tr class="section-total">
              <td class="section-title" style="width: 28%;">
                Total
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.total.today) }}
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.total.ptd) }}
              </td>
              <td class="n1-col">
                {{ formatCurrency(((contentN1?.posPayment?.outlets || []).find((o) => o.outlet === outlet.outlet))?.total?.ytd) }}
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.total.ytd) }}
              </td>
            </tr>
          @endeach
          <tr class="">
            <td>
              <strong>All Outlet's Payment Total</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posPayment?.total.today) }}</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posPayment?.total.ptd) }}</strong>
            </td>
            <td class="n1-col">
              <strong>{{ formatCurrency(contentN1?.posPayment?.total?.ytd) }}</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posPayment?.total.ytd) }}</strong>
            </td>
          </tr>
        </tbody>
      </table>
      <div class="horizontal-line">
      </div>

      <div class="section-title">
        Revenue Summary (without tax)
      </div>
      <table>
        <colgroup>
          <col style="width: 28%;">
          <col style="width: 18%;">
          <col style="width: 18%;">
          <col style="width: 16%;">
          <col style="width: 20%;">
        </colgroup>
        <tbody>
          <tr>
            <td>
              Room Revenue
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.roomRevenue.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.roomRevenue.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(contentN1?.revenueSummary?.roomRevenue?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.roomRevenue.ytd) }}
            </td>
          </tr>
          <tr class="">
            <td class="">
              Extra Revenue
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.extraRevenue.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.extraRevenue.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(contentN1?.revenueSummary?.extraRevenue?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.extraRevenue.ytd) }}
            </td>
          </tr>
          <tr class="section-total">
            <td class="">
              PMS Revenue
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.pmsRevenue.today) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.pmsRevenue.ptd) }}
            </td>
            <td class="n1-col">
              {{ formatCurrency(contentN1?.revenueSummary?.pmsRevenue?.ytd) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.revenueSummary?.pmsRevenue.ytd) }}
            </td>
          </tr>
          @each(outlet in content.posSummary?.outlets)
            <tr class="">
              <td class="">
                {{ outlet.outlet }}
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.totalWithoutTax.today) }}
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.totalWithoutTax.ptd) }}
              </td>
              <td class="n1-col">
                {{ formatCurrency(((contentN1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet))?.totalWithoutTax?.ytd) }}
              </td>
              <td class="currency">
                {{ formatCurrency(outlet.totalWithoutTax.ytd) }}
              </td>
            </tr>
          @endeach
          <tr class="section-total">
            <td>
              <strong>POS Revenue</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.today) }}</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ptd) }}</strong>
            </td>
            <td class="n1-col">
              <strong>{{ formatCurrency(contentN1?.posSummary?.totalWithoutTax?.ytd) }}</strong>
            </td>
            <td class="currency">
              <strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ytd) }}</strong>
            </td>
          </tr>
        </tbody>
      </table>
      <!-- total -->
      <div class="horizontal-line">
        <table>
          <colgroup>
            <col style="width: 28%;">
            <col style="width: 18%;">
            <col style="width: 18%;">
            <col style="width: 16%;">
            <col style="width: 20%;">
          </colgroup>
          <tbody>
            <tr class="font-bold">
              <td>
                Total Revenue
              </td>
              <td class="currency">
                {{ formatCurrency(content.totalRevenue?.today) }}
              </td>
              <td class="currency">
                {{ formatCurrency(content.totalRevenue?.ptd) }}
              </td>
              <td class="n1-col">
                {{ formatCurrency(contentN1?.totalRevenue?.ytd) }}
              </td>
              <td class="currency">
                {{ formatCurrency(content.totalRevenue?.ytd) }}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="horizontal-line">
      </div>
      <p>*Guest Ledger Closing Balance = Opening Balance - Carry Forwarded Advance Deposit + Charge Posted to Guest Ledger - Settlement by Guest</p>
      <p>*Transfer From Advance Deposit = Balance Transfer to Guest Ledger</p>
      <p>*PMS Revenue = Total Revenue without Tax (PMS)</p>
      <p>*POS Revenue = All Outlet's Total Revenue without Tax</p>
      <p>*Total Revenue = PMS Revenue + POS Revenue</p>
      <p>*YTD N-1 = from January 1st to report date, previous year</p>
 <div class="horizontal-line">
      </div>
    </div>

  </body>
</html>
