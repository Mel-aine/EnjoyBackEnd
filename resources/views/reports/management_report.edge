<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>
      Manager Report
    </title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        margin: 0;
        padding: 5px 20px 20px 20px;
        color: #333;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .horizontal-line {
        border-top: 1px solid #333;
        margin: 10px 0;
      }
      .report-info {
        margin-bottom: 20px;
        font-size: 11px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        page-break-inside: auto;
      }
      th,
      td {
        text-align: left;
        padding: 4px 0px;
        font-size: 11px;
      }
      .section-title {
        font-weight: bold;
        margin: 0px 0 5px 0;
        font-size: 12px;
      }
      .section-total {
        font-weight: bold;
        border-top: 1px dotted #333;
        border-bottom: 1px dotted #333;
      }
      .section-total-top {
        font-weight: bold;
        border-top: 1px dotted #333;
      }
      .section-total-bottom {
        font-weight: bold;
        border-bottom: 1px dotted #333;
      }
      .section-subtotal {
        font-weight: bold;
        border-top: 1px solid #ddd;
      }
      .bold-section {
        font-weight: bold;
      }
      .currency {
        text-align: right;
      }
      .footer-line {
        border-top: 1px solid #333;
        margin-bottom: 5px;
      }
      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .font-bold{
        font-weight: 900;
      }
      tr {
        page-break-inside: avoid;
      }

      thead {
        display: table-header-group;
      }
      @media print {
        .page-break {
          padding-top:20px
          page-break-before: always;
        }
      }
    </style>
  </head>
  <body>
    <div class="main">

      <!-- Section 1: Room Charges -->
      <div class="section-title">
        Room Charges
      </div>
      <table>
        <tbody>
          <tr>
            <td style="width: 32%;">Room Charges</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.roomCharges?.roomCharges?.today) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.roomCharges?.roomCharges?.ptd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.roomCharges?.roomCharges?.ytd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.n1?.roomCharges?.roomCharges?.today) }}</td>
          </tr>
          <tr>
            <td>Cancellation Revenue</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.cancellationRevenue.today) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.cancellationRevenue.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.cancellationRevenue.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.roomCharges?.cancellationRevenue?.today) }}</td>
          </tr>
          <tr>
            <td>No Show Revenue</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.noShowRevenue.today) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.noShowRevenue.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.noShowRevenue.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.roomCharges?.noShowRevenue?.today) }}</td>
          </tr>
          @if(content.roomCharges?.lateCheckoutCharges && (content.roomCharges?.lateCheckoutCharges?.today || content.roomCharges?.lateCheckoutCharges?.ptd || content.roomCharges?.lateCheckoutCharges?.ytd))
          <tr>
            <td>Late Checkout Charges</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.lateCheckoutCharges.today) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.lateCheckoutCharges.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.roomCharges?.lateCheckoutCharges.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.roomCharges?.lateCheckoutCharges?.today) }}</td>
          </tr>
          @endif
          <tr class="section-total">
            <td><strong>Total Room Charges</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.roomCharges?.total.today) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.roomCharges?.total.ptd) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.roomCharges?.total.ytd) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.n1?.roomCharges?.total?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 2: Extra Charges -->
      <div class="section-title">
        Extra Charges
      </div>
      <table>
        <tbody>
          @each(extraCharge in Object.keys(content.extraCharges.extraCharges || {}))

              <tr>
                <td style="width: 32%;">{{ extraCharge }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(content.extraCharges.extraCharges[extraCharge].today) }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(content.extraCharges.extraCharges[extraCharge].ptd) }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(content.extraCharges.extraCharges[extraCharge].ytd) }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(content.n1?.extraCharges?.extraCharges?.[extraCharge]?.today) }}</td>
              </tr>

          @endeach
          <tr class="section-total">
            <td style="width: 32%;"><strong>Total Extra Charges</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.extraCharges.totals?.today || content.extraCharges.today) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.extraCharges.totals?.ptd || content.extraCharges.ptd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.extraCharges.totals?.ytd || content.extraCharges.ytd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.extraCharges?.totals?.today || content.n1?.extraCharges?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 3: Discount -->
      <div class="section-title">
        Discount
      </div>
      <table>
        <tbody>
          @each(discount in (content.discounts.discounts || []))
            <tr>
              <td style="width: 32%">{{ discount.name }} ({{ discount.shortCode }})</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(discount.today) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(discount.ptd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(discount.ytd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency((content.n1?.discounts?.discounts || []).find((d) => d.name === discount.name)?.today) }}</td>
            </tr>
          @endeach
          <tr class="section-total">
            <td style="width: 32%"><strong>Total Discount</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.discounts.totals?.today || content.discounts.today) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.discounts.totals?.ptd || content.discounts.ptd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.discounts.totals?.ytd || content.discounts.ytd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.discounts?.totals?.today || content.n1?.discounts?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 4: Adjustments -->
      @if(content.adjustments.adjustments && content.adjustments.adjustments.length > 0)
      <div class="section-title">
        Adjustments
      </div>
      <table>
        <tbody>
          @each(adjustment in (content.adjustments.adjustments || []))
            <tr>
              <td style="width: 32%;">{{ adjustment.name }}</td>
