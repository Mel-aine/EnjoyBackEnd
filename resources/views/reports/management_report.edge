          </tr>
        </tbody>
      </table>

      <!-- Bold Section After Tax -->
      <table>
        <tbody>
          <tr class="bold-section">
            <td style="width: 32%;"><strong>Total Revenue without Tax</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.totals.revenueWithoutTax.today) }}</strong></td>
