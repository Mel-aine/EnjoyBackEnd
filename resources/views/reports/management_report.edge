            <td class="currency" style="width: 17%;">{{ formatCurrency(content.n1?.guestLedger?.openingBalance?.today) }}</td>
          </tr>
          <tr>
            <td>Carry Forwarded Advance Deposit</td>
            <td class="currency">{{ formatCurrency(content.guestLedger?.carryForwardedAdvanceDeposit?.today) }}</td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency">{{ formatCurrency(content.n1?.guestLedger?.carryForwardedAdvanceDeposit?.today) }}</td>
          </tr>
          <tr>
            <td>Charge Posted to Guest Ledger</td>
            <td class="currency">{{ formatCurrency(content.guestLedger?.chargePostedToGuestLedger?.today) }}</td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency">{{ formatCurrency(content.n1?.guestLedger?.chargePostedToGuestLedger?.today) }}</td>
          </tr>
          <tr>
            <td>Settlement by Guest</td>
            <td class="currency">{{ formatCurrency(content.guestLedger?.settlementByGuest?.today) }}</td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency">{{ formatCurrency(content.n1?.guestLedger?.settlementByGuest?.today) }}</td>
          </tr>
          <tr>
            <td>Outstanding Payment on Charges</td>
            <td class="currency">{{ formatCurrency(content.guestLedger?.outstandingPaymentOnCharges?.today) }}</td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency">{{ formatCurrency(content.n1?.guestLedger?.outstandingPaymentOnCharges?.today) }}</td>
          </tr>
          <tr>
            <td>Transfer from Advance Deposit</td>
            <td class="currency">{{ formatCurrency(content.guestLedger?.transferFromAdvanceDeposit?.today) }}</td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency">{{ formatCurrency(content.n1?.guestLedger?.transferFromAdvanceDeposit?.today) }}</td>
          </tr>
          <tr class="section-total">
            <td><strong>Closing Balance</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.guestLedger?.closingBalance?.today) }}</strong></td>
            <td class="currency"></td>
            <td class="currency"></td>
            <td class="currency"><strong>{{ formatCurrency(content.n1?.guestLedger?.closingBalance?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>

      <!-- Section 10: Room Summary -->
      <div class="section-title">
        Room Summary
      </div>
      <table>
        <tbody>
          <tr>
            <td style="width: 32%;">Total Rooms</td>
            <td class="currency" style="width: 17%;">{{ content.roomSummary?.totalRoom?.today || 0 }}</td>
            <td class="currency" style="width: 17%;">{{ content.roomSummary?.totalRoom?.ptd || 0 }}</td>
            <td class="currency" style="width: 17%;">{{ content.roomSummary?.totalRoom?.ytd || 0 }}</td>
            <td class="currency" style="width: 17%;">{{ content.n1?.roomSummary?.totalRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Blocked Rooms</td>
            <td class="currency">{{ content.roomSummary?.blockRoom?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.blockRoom?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.blockRoom?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.blockRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No of Guest (Adult/Child)</td>
            <td class="currency">{{ content.roomSummary?.noOfGuestAdult?.today || 0 }}/{{ content.roomSummary?.noOfGuestChild?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfGuestAdult?.ptd || 0 }}/{{ content.roomSummary?.noOfGuestChild?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfGuestAdult?.ytd || 0 }}/{{ content.roomSummary?.noOfGuestChild?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.noOfGuestAdult?.today || 0 }}/{{ content.n1?.roomSummary?.noOfGuestChild?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Total Available Room nights</td>
            <td class="currency">{{ content.roomSummary?.totalAvailableRoomNights?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.totalAvailableRoomNights?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.totalAvailableRoomNights?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.totalAvailableRoomNights?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Sold Room</td>
            <td class="currency">{{ content.roomSummary?.soldRoom?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.soldRoom?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.soldRoom?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.soldRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Day Use Room</td>
            <td class="currency">{{ content.roomSummary?.dayUseRoom?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.dayUseRoom?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.dayUseRoom?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.dayUseRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Complimentary Room</td>
            <td class="currency">{{ content.roomSummary?.complimentaryRoom?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.complimentaryRoom?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.complimentaryRoom?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.complimentaryRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No Show Rooms</td>
            <td class="currency">{{ content.roomSummary?.noShows?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noShows?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noShows?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.noShows?.today || 0 }}</td>
          </tr>
          <tr>
            <td>Average Guest Per Room</td>
            <td class="currency">{{ content.roomSummary?.averageGuestPerRoom?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.averageGuestPerRoom?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.averageGuestPerRoom?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.averageGuestPerRoom?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No of Reservations (Confirm)</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsConfirm?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsConfirm?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsConfirm?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.noOfReservationsConfirm?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No of Reservations (Unconfirm)</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsUnconfirm?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsUnconfirm?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfReservationsUnconfirm?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.noOfReservationsUnconfirm?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No of Walkins</td>
            <td class="currency">{{ content.roomSummary?.noOfWalkins?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfWalkins?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.noOfWalkins?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.noOfWalkins?.today || 0 }}</td>
          </tr>
          <tr>
            <td>No of Reservation (cancellations)</td>
            <td class="currency">{{ content.roomSummary?.cancellations?.today || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.cancellations?.ptd || 0 }}</td>
            <td class="currency">{{ content.roomSummary?.cancellations?.ytd || 0 }}</td>
            <td class="currency">{{ content.n1?.roomSummary?.cancellations?.today || 0 }}</td>
          </tr>
        </tbody>
      </table>

      <!-- Section 11: Statistics -->
      <div class="section-title">
        Statistics
      </div>
      <table>
        <tbody>
          <tr>
            <td style="width: 32%;">Occupancy Rate (%)</td>
            <td class="currency" style="width: 17%;">{{ (content.statistics?.occupancyRate?.today || 0).toFixed(0) }}%</td>
            <td class="currency" style="width: 17%;">{{ (content.statistics?.occupancyRate?.ptd || 0).toFixed(0) }}%</td>
            <td class="currency" style="width: 17%;">{{ (content.statistics?.occupancyRate?.ytd || 0).toFixed(0) }}%</td>
            <td class="currency" style="width: 17%;">{{ (content.n1?.statistics?.occupancyRate?.today || 0).toFixed(0) }}%</td>
          </tr>
          <tr>
            <td>Average Daily Rate (ADR)</td>
            <td class="currency">{{ formatCurrency(content.statistics?.averageDailyRate?.today) }}</td>
            <td class="currency">{{ formatCurrency(content.statistics?.averageDailyRate?.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.statistics?.averageDailyRate?.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.statistics?.averageDailyRate?.today) }}</td>
          </tr>
          <tr>
            <td>Revenue Per Available Room (RevPAR)</td>
            <td class="currency">{{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.today) }}</td>
            <td class="currency">{{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.statistics?.revenuePerAvailableRoom?.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.statistics?.revenuePerAvailableRoom?.today) }}</td>
          </tr>
        </tbody>
      </table>

      <!-- Section 12: POS Summary -->
      <div class="horizontal-line"></div>
      <div class="section-title">
        POS Summary
      </div>
      <div class="horizontal-line"></div>

      <table>
        <tbody>
        @each(outlet in content.posSummary?.outlets)
          <tr>
            <td class="section-title" style="width: 32%;">{{ outlet.outlet }}</td>
            <td style="width: 17%;"></td>
            <td style="width: 17%;"></td>
            <td style="width: 17%;"></td>
            <td style="width: 17%;"></td>
          </tr>
          @each(category in outlet.categories)
            <tr>
              <td style="width: 32%;">{{ category.name }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(category?.today) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(category?.ptd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(category?.ytd) }}</td>
              <td class="currency" style="width: 17%;">
                {{ formatCurrency(((content.n1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet)?.categories || []).find((c) => c.name === category.name)?.today) }}
              </td>
            </tr>
          @endeach
          <tr class="section-total-top">
            <td class="section-title" style="width: 32%;">Total Revenue without Tax</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithoutTax.today) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithoutTax.ptd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithoutTax.ytd) }}</td>
            <td class="currency" style="width: 17%;">
              {{ formatCurrency((content.n1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet)?.totalWithoutTax?.today) }}
            </td>
          </tr>
          <tr class="section-total-bottom">
            <td class="section-title" style="width: 32%;">Total Revenue with Tax</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithTax.today) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithTax.ptd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.totalWithTax.ytd) }}</td>
            <td class="currency" style="width: 17%;">
              {{ formatCurrency((content.n1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet)?.totalWithTax?.today) }}
            </td>
          </tr>
        @endeach
        <tr class="">
          <td style="width: 32%;"><strong>All Outlet's Total Revenue without Tax</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.today) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ptd) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ytd) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.posSummary?.totalWithoutTax?.today) }}</strong></td>
        </tr>
        <tr class="section-total-bottom">
          <td style="width: 32%;"><strong>All Outlet's Total Revenue with Tax</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithTax.today) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithTax.ptd) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posSummary?.totalWithTax.ytd) }}</strong></td>
          <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.posSummary?.totalWithTax?.today) }}</strong></td>
        </tr>
        </tbody>
      </table>

      <!-- Section 13: POS Payment Summary -->
      <div class="horizontal-line"></div>
      <div class="section-title">
        POS Payment Summary
      </div>
      <div class="horizontal-line"></div>

      <table>
        <tbody>
          @each(outlet in content.posPayment?.outlets)
            <tr>
              <td class="section-title" style="width: 32%;">{{ outlet.outlet }}</td>
              <td style="width: 17%;"></td>
              <td style="width: 17%;"></td>
              <td style="width: 17%;"></td>
              <td style="width: 17%;"></td>
            </tr>
            @each(payment in outlet.payments)
              <tr>
                <td style="width: 32%;">{{ payment.name }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(payment?.today) }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(payment?.ptd) }}</td>
                <td class="currency" style="width: 17%;">{{ formatCurrency(payment?.ytd) }}</td>
                <td class="currency" style="width: 17%;">
                  {{ formatCurrency(((content.n1?.posPayment?.outlets || []).find((o) => o.outlet === outlet.outlet)?.payments || []).find((p) => p.name === payment.name)?.today) }}
                </td>
              </tr>
            @endeach
            <tr class="section-total">
              <td class="section-title" style="width: 32%;">Total</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.total.today) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.total.ptd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(outlet.total.ytd) }}</td>
              <td class="currency" style="width: 17%;">
                {{ formatCurrency((content.n1?.posPayment?.outlets || []).find((o) => o.outlet === outlet.outlet)?.total?.today) }}
              </td>
            </tr>
          @endeach
          <tr class="">
            <td style="width: 32%;"><strong>All Outlet's Payment Total</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posPayment?.total.today) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posPayment?.total.ptd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.posPayment?.total.ytd) }}</strong></td>
            <td class="currency" style="width: 17%;"><strong>{{ formatCurrency(content.n1?.posPayment?.total?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>
      <div class="horizontal-line"></div>

      <div class="section-title">
        Revenue Summary (without tax)
      </div>
      <table>
        <tbody>
          <tr class="">
            <td style="width: 32%;">Room Revenue</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.revenueSummary?.roomRevenue.today) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.revenueSummary?.roomRevenue.ptd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.revenueSummary?.roomRevenue.ytd) }}</td>
            <td class="currency" style="width: 17%;">{{ formatCurrency(content.n1?.revenueSummary?.roomRevenue?.today) }}</td>
          </tr>
          <tr class="">
            <td>Extra Revenue</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.extraRevenue.today) }}</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.extraRevenue.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.extraRevenue.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.revenueSummary?.extraRevenue?.today) }}</td>
          </tr>
          <tr class="section-total">
            <td>PMS Revenue</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.pmsRevenue.today) }}</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.pmsRevenue.ptd) }}</td>
            <td class="currency">{{ formatCurrency(content.revenueSummary?.pmsRevenue.ytd) }}</td>
            <td class="currency">{{ formatCurrency(content.n1?.revenueSummary?.pmsRevenue?.today) }}</td>
          </tr>
          <tr class="section-total">
            <td class="">
              Banquets & Events Revenue
            </td>
            <td class="currency">
              {{ formatCurrency(content.banquetsEvents?.revenueWithoutTax?.today || 0) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.banquetsEvents?.revenueWithoutTax?.ptd || 0) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.banquetsEvents?.revenueWithoutTax?.ytd || 0) }}
            </td>
            <td class="currency">
              {{ formatCurrency(content.n1?.banquetsEvents?.revenueWithoutTax?.today || 0) }}
            </td>
          </tr>
          @each(outlet in content.posSummary?.outlets)
            <tr class="">
              <td>{{ outlet.outlet }}</td>
              <td class="currency">{{ formatCurrency(outlet.totalWithoutTax.today) }}</td>
              <td class="currency">{{ formatCurrency(outlet.totalWithoutTax.ptd) }}</td>
              <td class="currency">{{ formatCurrency(outlet.totalWithoutTax.ytd) }}</td>
              <td class="currency">
                {{ formatCurrency((content.n1?.posSummary?.outlets || []).find((o) => o.outlet === outlet.outlet)?.totalWithoutTax?.today) }}
              </td>
            </tr>
          @endeach
          <tr class="section-total">
            <td><strong>POS Revenue</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.today) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ptd) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.posSummary?.totalWithoutTax.ytd) }}</strong></td>
            <td class="currency"><strong>{{ formatCurrency(content.n1?.posSummary?.totalWithoutTax?.today) }}</strong></td>
          </tr>
        </tbody>
      </table>

      <!-- total -->
      <div class="horizontal-line">
        <table>
          <tbody>
            <tr class="font-bold">
              <td style="width: 32%;">Total Revenue</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(content.totalRevenue?.today) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(content.totalRevenue?.ptd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(content.totalRevenue?.ytd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency(content.n1?.totalRevenue?.today) }}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="horizontal-line"></div>
      <p>*Guest Ledger Closing Balance = Opening Balance - Carry Forwarded Advance Deposit + Charge Posted to Guest Ledger - Settlement by Guest</p>
      <p>*Transfer From Advance Deposit = Balance Transfer to Guest Ledger</p>
      <p>*PMS Revenue = Total Revenue without Tax (PMS)</p>
      <p>*POS Revenue = All Outlet's Total Revenue without Tax</p>
      <p>*Total Revenue = PMS Revenue + POS Revenue + Banquets & Events Revenue</p>
 <div class="horizontal-line">
      </div>
    </div>

  </body>
</html>
