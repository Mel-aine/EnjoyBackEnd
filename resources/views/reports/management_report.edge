              <td class="currency" style="width: 17%;">{{ formatCurrency(taxRate.ytd) }}</td>
              <td class="currency" style="width: 17%;">{{ formatCurrency((content.n1?.tax?.taxes || []).find((t) => t.name === taxRate.name)?.today) }}</td>
