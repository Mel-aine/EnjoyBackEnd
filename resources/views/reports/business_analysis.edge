            border: 1px solid #e2e8f0;
            border-left: 4px solid #1b365d;
            border-radius: 4px;
            padding: 8px;
            margin-right: 1.5%;
            margin-bottom: 8px;
            vertical-align: top;
            page-break-inside: avoid;
        }
        .kpi-box:last-child { margin-right: 0; }
        .kpi-title {
            font-size: 7.5pt;
            color: #4a5568;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 3px;
