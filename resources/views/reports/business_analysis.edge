{{-- <!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Business Analysis Report</title>
    <style>
        @page {
            size: A4;
            margin: 15mm 12mm;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            font-size: 9.5pt;
            line-height: 1.35;
            color: #222;
        }
        .header-container {
            border-bottom: 2px solid #1b365d;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .hotel-title {
            font-size: 16pt;
            font-weight: bold;
            color: #1b365d;
