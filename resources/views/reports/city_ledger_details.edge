<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>City Ledger Details</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 10px;
        margin: 0;
        padding: 0;
        color: #333;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        page-break-inside: auto;
      }
      tr {
        page-break-inside: avoid;
      }
      th, td {
        text-align: left;
        padding: 3px 1px;
        font-size: 10px;
        border-bottom: 1px dotted #ccc;
      }
      td.center {
        text-align: center;
      }
      td.num, th.num {
        text-align: right;
      }
      tfoot td {
        font-weight: bold;
        border-top: 1.5px solid #555;
        border-bottom: none;
        background: #EFEFEF;
      }
      .no-data {
        text-align: center;
        padding: 20px 0;
        color: #888;
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <table>
      <tbody>
        @if(data.rows.length === 0)
          <tr>
            <td colspan="8" class="no-data">No City Ledger transactions found for the selected period</td>
          </tr>
        @else
          @each((row, index) in data.rows)
            <tr>
              <td class="center" style="width: 4%;">{{ index + 1 }}</td>
              <td style="width: 14%;">{{ row.accountName }}</td>
              <td style="width: 8%;">{{ row.date.toFormat('dd/MM/yyyy') }}</td>
              <td style="width: 24%;">{{ row.description }}</td>
              <td style="width: 9%;">{{ row.paymentType }}</td>
              <td style="width: 18%; font-size: 9px;">
                <div>{{ row.reservationNumber }}</div>
                <div style="color: #555; font-size: 8px;">
                  Arr: {{ row.arrivalDate ? row.arrivalDate.toFormat('dd/MM/yyyy') : '—' }}<br />
                  Dep: {{ row.departureDate ? row.departureDate.toFormat('dd/MM/yyyy') : '—' }}<br />
                  Room: {{ row.roomNumber }}
                </div>
              </td>
              <td class="num" style="width: 6.5%;">{{ helpers.fc(row.credit) }}</td>
              <td class="num" style="width: 6.5%;">{{ helpers.fc(row.debit) }}</td>
            </tr>
          @endeach
        @endif
      </tbody>
      @if(data.rows.length > 0)
      <tfoot>
        <tr>
          <td colspan="6" style="text-align: left;"><strong>TOTAL</strong></td>
          <td class="num" style="width: 6.5%;"><strong>{{ helpers.fc(data.totals.totalCredit) }}</strong></td>
          <td class="num" style="width: 6.5%;"><strong>{{ helpers.fc(data.totals.totalDebit) }}</strong></td>
        </tr>
      </tfoot>
      @endif
    </table>
  </body>
</html>