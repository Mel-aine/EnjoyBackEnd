<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Weekly Services Report</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 10px;
        margin: 0;
        padding: 5px 10px;
        color: #333;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
        table-layout: fixed;
      }

      th, td {
        text-align: right;
        padding: 3px 4px;
        font-size: 9px;
        border-bottom: 1px solid #eee;
      }

      th {
        background-color: #f5f5f5;
        font-weight: bold;
        border-bottom: 2px solid #333;
        font-size: 9px;
      }

      td.label {
        text-align: left;
        font-weight: normal;
      }

      td.section-title {
        text-align: left;
        font-weight: bold;
        font-size: 10px;
        padding-top: 8px;
        border-bottom: 1px solid #333;
      }

      tr.total-row td {
        font-weight: bold;
        border-top: 1px dotted #333;
        border-bottom: 1px dotted #333;
      }

      tr.grand-total td {
        font-weight: bold;
        border-top: 2px solid #333;
        border-bottom: 2px solid #333;
        font-size: 10px;
      }

      .col-label { width: 20%; text-align: left; }
      .col-day { width: 10%; }
      .col-total { width: 10%; font-weight: bold; }
    </style>
  </head>
  <body>
    <table>
      <colgroup>
        <col style="width: 20%;">
        @each(day in weekDays)
          <col style="width: 10%;">
        @endeach
        <col style="width: 10%;">
      </colgroup>
      <thead>
        <tr>
          <th class="col-label">Particulars</th>
          @each(day in weekDays)
            <th>{{ day.dayName }}<br>{{ day.dayLabel }}</th>
          @endeach
          <th class="col-total">Total</th>
        </tr>
      </thead>
      <tbody>
        <!-- Room Charges -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Room Charges</td>
        </tr>
        <tr>
          <td class="label">Room Charges</td>
          @each(day in weekDays)
            <td>{{ formatCurrency(day.data?.roomCharges?.roomCharges?.today) }}</td>
          @endeach
          <td>{{ formatCurrency(totals.roomCharges.today) }}</td>
        </tr>
        <tr>
          <td class="label">Cancellation Revenue</td>
          @each(day in weekDays)
            <td>{{ formatCurrency(day.data?.roomCharges?.cancellationRevenue?.today) }}</td>
          @endeach
          <td>{{ formatCurrency(totals.cancellationRevenue.today) }}</td>
        </tr>
        <tr>
          <td class="label">No Show Revenue</td>
          @each(day in weekDays)
            <td>{{ formatCurrency(day.data?.roomCharges?.noShowRevenue?.today) }}</td>
          @endeach
          <td>{{ formatCurrency(totals.noShowRevenue.today) }}</td>
        </tr>
        <tr>
          <td class="label">Late Checkout Charges</td>
          @each(day in weekDays)
            <td>{{ formatCurrency(day.data?.roomCharges?.lateCheckoutCharges?.today) }}</td>
          @endeach
          <td>{{ formatCurrency(totals.lateCheckoutCharges.today) }}</td>
        </tr>
        <tr class="total-row">
          <td class="label"><strong>Total Room Charges</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.roomCharges?.total?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.totalRoomCharges.today) }}</strong></td>
        </tr>

        <!-- Extra Charges -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Extra Charges</td>
        </tr>
        @each(day in weekDays)
          @if(day.data?.extraCharges?.extraCharges)
            @each(chargeName in Object.keys(day.data.extraCharges.extraCharges))
              @if(!day.data.extraCharges.extraCharges[chargeName].isDeleted && day.data.extraCharges.extraCharges[chargeName].today !== 0)
                <tr>
                  <td class="label">{{ chargeName }}</td>
                  @each(d in weekDays)
                    <td>{{ formatCurrency(d.data?.extraCharges?.extraCharges?.[chargeName]?.today) }}</td>
                  @endeach
                  <td></td>
                </tr>
              @endif
            @endeach
          @endif
        @endeach
        <tr class="total-row">
          <td class="label"><strong>Total Extra Charges</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.extraCharges?.totals?.today || day.data?.extraCharges?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.extraChargesTotal.today) }}</strong></td>
        </tr>

        <!-- Discounts -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Discounts</td>
        </tr>
        @each(day in weekDays)
          @if(day.data?.discounts?.discounts)
            @each(disc in day.data.discounts.discounts)
              @if(disc.today !== 0)
                <tr>
                  <td class="label">{{ disc.name }} ({{ disc.shortCode }})</td>
                  @each(d in weekDays)
                    <td>{{ formatCurrency((d.data?.discounts?.discounts || []).find((x) => x.shortCode === disc.shortCode)?.today) }}</td>
                  @endeach
                  <td></td>
                </tr>
              @endif
            @endeach
          @endif
        @endeach
        <tr class="total-row">
          <td class="label"><strong>Total Discounts</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.discounts?.totals?.today || day.data?.discounts?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.discountsTotal.today) }}</strong></td>
        </tr>

        <!-- Adjustments -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Adjustments</td>
        </tr>
        @each(day in weekDays)
          @if(day.data?.adjustments?.adjustments)
            @each(adj in day.data.adjustments.adjustments)
              @if(adj.today !== 0)
                <tr>
                  <td class="label">{{ adj.name }}</td>
                  @each(d in weekDays)
                    <td>{{ formatCurrency((d.data?.adjustments?.adjustments || []).find((x) => x.name === adj.name)?.today) }}</td>
                  @endeach
                  <td></td>
                </tr>
              @endif
            @endeach
          @endif
        @endeach
        <tr class="total-row">
          <td class="label"><strong>Total Adjustments</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.adjustments?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.adjustmentsTotal.today) }}</strong></td>
        </tr>

        <!-- Tax -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Tax</td>
        </tr>
        @each(day in weekDays)
          @if(day.data?.tax?.taxes)
            @each(taxItem in day.data.tax.taxes)
              @if(taxItem.today !== 0)
                <tr>
                  <td class="label">{{ taxItem.name }}</td>
                  @each(d in weekDays)
                    <td>{{ formatCurrency((d.data?.tax?.taxes || []).find((x) => x.name === taxItem.name)?.today) }}</td>
                  @endeach
                  <td></td>
                </tr>
              @endif
            @endeach
          @endif
        @endeach
        <tr class="total-row">
          <td class="label"><strong>Total Tax</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.tax?.totals?.today || day.data?.tax?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.taxTotal.today) }}</strong></td>
        </tr>

        <!-- Payments -->
        <tr>
          <td class="section-title" colspan="{{ weekDays.length + 2 }}">Payments</td>
        </tr>
        @each(day in weekDays)
          @if(day.data?.payments?.methods)
            @each(methodName in Object.keys(day.data.payments.methods))
              @if(day.data.payments.methods[methodName].today !== 0)
                <tr>
                  <td class="label">{{ methodName }}</td>
                  @each(d in weekDays)
                    <td>{{ formatCurrency(d.data?.payments?.methods?.[methodName]?.today) }}</td>
                  @endeach
                  <td></td>
                </tr>
              @endif
            @endeach
          @endif
        @endeach
        <tr class="total-row">
          <td class="label"><strong>Total Payments</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.payments?.total?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.paymentsTotal.today) }}</strong></td>
        </tr>

        <!-- Grand Total -->
        <tr class="grand-total">
          <td class="label"><strong>Total Revenue</strong></td>
          @each(day in weekDays)
            <td><strong>{{ formatCurrency(day.data?.totalRevenue?.today) }}</strong></td>
          @endeach
          <td><strong>{{ formatCurrency(totals.totalRevenue.today) }}</strong></td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
