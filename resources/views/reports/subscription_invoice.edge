<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice {{ invoice.invoiceNumber }}</title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; color: #111; background: #fff; }
      .page { padding: 28px; }
      .card { border: none; padding: 18px; }
      .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
      .logo { width: 200px; height: 80px; object-fit: contain; }
      .title { font-size: 22px; font-weight: 800; letter-spacing: 0.5px; }
      .meta { font-size: 13px; color: #333; margin-top: 4px; line-height: 1.35; }
      .grid { display: flex; gap: 18px; margin-top: 14px; }
      .box { flex: 1; border: none; padding: 10px; }
      .box-title { font-size: 13px; font-weight: 700; margin-bottom: 6px; }
      .row { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding: 3px 0; }
      .row .k { color: #333; }
      .row .v { font-weight: 600; text-align: right; }
      table { width: 100%; border-collapse: collapse; margin-top: 14px; }
      th, td { border: 1px solid #000; padding: 8px; font-size: 13px; vertical-align: top; }
      th { background: #f2f2f2; text-align: left; }
      td.right, th.right { text-align: right; }
      .totals { margin-top: 12px; display: flex; justify-content: flex-end; }
      .totals-box { width: 320px; border: none; padding: 10px; }
      .amount-due .k, .amount-due .v { font-weight: 800; }
      .footer { margin-top: 14px; font-size: 12px; color: #444; display: flex; justify-content: space-between; }
      .muted { color: #666; font-weight: 500; }
      pre.json { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 12px; line-height: 1.35; }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="card">
        <div class="top">
          <div>
            <div class="title">INVOICE</div>
            <div class="meta">
              <div>Invoice #: <strong>{{ invoice.invoiceNumber }}</strong></div>
              <div>Billing date: <strong>{{ invoice.billingDate }}</strong></div>
              <div>Period: <strong>{{ invoice.periodStart }}</strong> - <strong>{{ invoice.periodEnd }}</strong></div>
              <div>Status: <strong>{{ invoice.status }}</strong></div>
            </div>
          </div>
          <div style="text-align:right">
            <img class="logo" src="{{ logoDataUri }}" alt="Enjoy" />
            
          </div>
        </div>

        <div class="grid">
          <div class="box">
            <div class="box-title">Billing From</div>
            <div class="meta">
              <div><strong>ARON CLOUD SARL</strong></div>
              <div>86 Boulevard de la liberté, Ndongbong, Akwa, Douala</div>
              <div>Immeuble CHRIS COMPLEX, MAISON DAMAS, YAOUNDE</div>
              <div>BP 13253 DOUALA</div>
              <div>Cameroun</div>
            </div>
          </div>
          <div class="box">
            <div class="box-title">Billing To</div>
            <div class="meta">
              <div><strong>{{ hotel.hotelName }}</strong></div>
              <div>{{ hotel.address }}</div>
              @if(hotel.city || hotel.country)
                <div>{{ hotel.city }} {{ hotel.country }}</div>
              @endif
              <div>{{ hotel.email }}</div>
            </div>
          </div>
        </div>

        <table>
          <thead>
            <tr>
              <th style="width: 58%">Description</th>
              <th class="right" style="width: 10%">Qty</th>
              <th class="right" style="width: 16%">Unit Price</th>
              <th class="right" style="width: 16%">Amount</th>
            </tr>
          </thead>
          <tbody>
            @each(line in lines)
              <tr>
                <td>{{ line.description }}</td>
                <td class="right">{{ line.qty }}</td>
                <td class="right">{{ line.unitPrice }} {{ invoice.currency }}</td>
                <td class="right">{{ line.amount }} {{ invoice.currency }}</td>
              </tr>
            @endeach
          </tbody>
        </table>

        <div class="totals">
          <div class="totals-box">
            <div class="row"><div class="k">Subtotal</div><div class="v">{{ invoice.subtotalAmount }} {{ invoice.currency }}</div></div>
            <div class="row"><div class="k">Total</div><div class="v">{{ invoice.totalAmount }} {{ invoice.currency }}</div></div>
            <div class="row amount-due"><div class="k">Amount Due</div><div class="v">{{ invoice.amountDue }} {{ invoice.currency }}</div></div>
          </div>
        </div>

        <div class="footer">
          <div class="muted">Enjoy Console Subscription Invoicing</div>
        </div>
      </div>
    </div>
  </body>
</html>
