<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Guest Reservations</title>
    <style>
      body { font-family: Arial, sans-serif; font-size: 10px; margin: 0; padding: 0; color: #333; }
      table { width: 100%; border-collapse: collapse; page-break-inside: auto; }
      tr { page-break-inside: avoid; }
      th, td { text-align: left; padding: 3px 1px; font-size: 10px; border-bottom: 1px dotted #ccc; }
      td.center { text-align: center; }
      td.num, th.num { text-align: right; }
      tfoot td { font-weight: bold; border-top: 1.5px solid #555; border-bottom: none; background: #EFEFEF; }
      .no-data { text-align: center; padding: 20px 0; color: #888; font-style: italic; }
      tfoot { display: table-row-group; }
      tfoot tr { page-break-inside: avoid; }
      td.by { padding-left: 14px; }
    </style>
  </head>
  <body>
    <table>
      <tbody>
        @if(data.rows.length === 0)
          <tr>
            <td colspan="9" class="no-data">No reservations found for this guest in the selected period</td>
          </tr>
        @else
          @each((row, index) in data.rows)
            <tr>
              <td style="width: 11%;">{{ row.reservationNumber }}</td>
              <td style="width: 14%;">{{ row.guestName }}</td>
              <td style="width: 11%;">{{ row.roomTypeName }}</td>
              <td style="width: 8%;">{{ row.arrivalDate ? row.arrivalDate.toFormat('dd/MM/yyyy') : '—' }}</td>
              <td style="width: 8%;">{{ row.departureDate ? row.departureDate.toFormat('dd/MM/yyyy') : '—' }}</td>
              <td class="num" style="width: 10%;">{{ helpers.fc(row.ratePerNight) }}</td>
              <td class="num" style="width: 10%;">{{ helpers.fc(row.totalAmount) }}</td>
              <td class="num" style="width: 10%;">{{ helpers.fc(row.paidAmount) }}</td>
              <td class="by" style="width: 18%;">{{ row.checkedBy }}</td>
            </tr>
          @endeach
        @endif
      </tbody>

    </table>
  </body>
</html>
